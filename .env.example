# Copy to .env / export before running. Never commit real secrets.
MDAI_SECRET_KEY=generate-a-long-random-hex-string
MDAI_DATABASE_URL=sqlite:////absolute/path/instance/app.db
MDAI_ADMIN_EMAIL=admin@example.com
MDAI_ADMIN_PASSWORD=replace-with-a-strong-password
MDAI_MAX_UPLOAD_MB=50
MDAI_USB_ROOT=/media
MDAI_USB_MAX_FILES=200
MDAI_UNKNOWN_THRESHOLD=0.60
MDAI_SESSION_MINUTES=60
